# ─────────────────────────────────────────────────────────────────────
# Live Audience Messages — configurazione
#
# Per iniziare non serve NIENTE di tutto questo: con i default l'app gira
# in locale senza account e senza Docker (driver `memory` + `polling`).
# Copia questo file in `.env.local` solo quando vuoi cambiare qualcosa.
# ─────────────────────────────────────────────────────────────────────

# --- Evento ---------------------------------------------------------
NEXT_PUBLIC_EVENT_SLUG=default
# Frase di default dell'animazione di chiusura (pulsante "Vai alla schermata
# finale" in /admin). Il moderatore puo' cambiarla a caldo da
# /admin/settings senza redeploy: questa resta solo il valore iniziale.
NEXT_PUBLIC_CLOSING_PHRASE=Make that change

# --- Limiti del messaggio -------------------------------------------
# Contati in grafemi: un'emoji vale 1.
NEXT_PUBLIC_MESSAGE_MAX_LENGTH=80
NEXT_PUBLIC_NAME_MAX_LENGTH=24
# La frase di chiusura sta da sola al centro dello schermo: deve restare
# leggibile da lontano su una riga o due, non un paragrafo.
NEXT_PUBLIC_CLOSING_PHRASE_MAX_LENGTH=60

# --- Driver ---------------------------------------------------------
# DB_DRIVER: memory | supabase
#   memory   -> file JSON locale. Zero servizi. NON usabile su Vercel.
#   supabase -> Postgres gestito. Obbligatorio in produzione.
DB_DRIVER=memory
MEMORY_DB_FILE=.data/messages.json

# NEXT_PUBLIC_REALTIME_DRIVER: polling | supabase
#   polling  -> nessun servizio esterno, latenza ~2s. Funziona benissimo.
#   supabase -> WebSocket, latenza ~150ms.
NEXT_PUBLIC_REALTIME_DRIVER=polling

# --- Supabase (solo con i driver `supabase`) ------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#   ATTENZIONE: la service role key bypassa RLS. Solo variabile server,
#   mai con il prefisso NEXT_PUBLIC_.

# --- Sicurezza ------------------------------------------------------
# IP_HASH_SALT: genera con openssl rand -hex 32, non serve digitarlo a mano.
IP_HASH_SALT=cambiami-in-produzione
# ADMIN_PASSWORD: la password del form di login su /admin/login. A differenza
# di IP_HASH_SALT va digitata su un telefono la sera del concerto: scegli una
# frase breve e memorabile, non una stringa esadecimale generata a caso.
ADMIN_PASSWORD=cambiami-in-produzione
MAX_BODY_BYTES=2048

# --- Rate limiting --------------------------------------------------
# Interruttore unico. ACCESO di default: e' la protezione anti-spam per la
# serata vera. Spegnilo solo mentre sviluppi/testi invii ripetuti, e
# riaccendilo (o rimuovi la riga) prima del concerto.
RATE_LIMIT_ENABLED=true

# Un messaggio ogni 30 secondi a testa. E' l'unico dei tre limiti pensato per
# le persone invece che per le macchine, ed e' quello che tiene lo schermo di
# tutti invece che di uno solo. Non alzarlo per far entrare piu' messaggi:
# lascia lavorare la compressione automatica dei tempi del display.
RL_SESSION_WINDOW_MS=30000
RL_SESSION_MAX=1

# Tetto per indirizzo IP. NON e' un limite per persona: dietro il NAT del
# locale e dietro il CGNAT degli operatori mobili decine di spettatori
# arrivano dallo stesso IP (Vercel non pubblica record IPv6, quindi anche i
# telefoni in IPv6 escono dal NAT64 dell'operatore). Con una platea da ~350
# persone un valore basso non ferma chi spamma: spegne gruppi interi di
# spettatori che non hanno ancora scritto niente.
# 500 sta sopra qualunque grappolo reale e resta un tetto contro un flood da
# sorgente unica.  0 = ambito disattivato: e' la leva da tirare la sera stessa
# se comparissero 429 con messaggio "Hai gia' inviato diversi messaggi".
RL_IP_WINDOW_MS=600000
RL_IP_MAX=500

# Circuit breaker globale: protegge il sistema, non il singolo utente.
# Con 350 persone il traffico legittimo massimo e' ~700/minuto (il limite di
# sessione consente 2 messaggi al minuto a testa): sotto quella soglia il
# breaker scatterebbe contro il pubblico invece che contro un attacco.
RL_GLOBAL_WINDOW_MS=60000
RL_GLOBAL_MAX=1000

# --- Moderazione ----------------------------------------------------
# Nessun heartbeat da /admin per questo tempo => modalita' non presidiata.
OPERATOR_TIMEOUT_MS=60000
# In modalita' non presidiata, i messaggi puliti escono dopo questo ritardo.
AUTO_RELEASE_DELAY_MS=20000
# Finestra per fermare un messaggio approvato automaticamente.
DISPLAY_DELAY_MS=8000
# Quante frasi pre-scritte aggiunge un click sul pulsante "frasi pronte".
SYNTHETIC_BATCH_SIZE=10
# In /admin, sotto questa soglia di frasi "in rotazione ora" appare l'avviso
# che invita ad aggiungerne (pallino rosso). Sopra NEXT_PUBLIC_COMFORTABLE_
# ROTATION_THRESHOLD il pallino e' verde, in mezzo e' giallo.
NEXT_PUBLIC_LOW_ROTATION_THRESHOLD=8
# 50: calcolato sui 7 minuti della canzone e sui tempi reali del display,
# con una frase di lunghezza media (~60 caratteri).
NEXT_PUBLIC_COMFORTABLE_ROTATION_THRESHOLD=50

# --- Anti-bot -------------------------------------------------------
NEXT_PUBLIC_MIN_SUBMIT_MS=1500
# Oltre questo tempo l'invio dal telefono viene dichiarato perso e il pubblico
# vede l'errore invece del pulsante che gira all'infinito. Il rinvio e'
# idempotente (`clientMsgId` non cambia): se il messaggio era arrivato lo
# stesso, non compare due volte a schermo.
NEXT_PUBLIC_SUBMIT_TIMEOUT_MS=12000
# Turnstile: implementato ma SPENTO. Si accende in trenta secondi se il
# link finisce in giro. Vedi il README per il perche' del default.
NEXT_PUBLIC_TURNSTILE_ENABLED=false
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
TURNSTILE_FAIL_OPEN=true

# --- Tempi del display ----------------------------------------------
NEXT_PUBLIC_DISPLAY_HOLD_BASE_MS=4500
NEXT_PUBLIC_DISPLAY_HOLD_PER_CHAR_MS=60
NEXT_PUBLIC_DISPLAY_HOLD_MIN_MS=5000
NEXT_PUBLIC_DISPLAY_HOLD_MAX_MS=14000
NEXT_PUBLIC_DISPLAY_BURST_THRESHOLD=8
NEXT_PUBLIC_DISPLAY_BURST_SATURATION=25
NEXT_PUBLIC_POLL_INTERVAL_MS=2000
NEXT_PUBLIC_POLL_MAX_INTERVAL_MS=8000
# Tetto di attesa per una richiesta del feed. Senza, una richiesta appesa su
# una rete che sta morendo blocca gli aggiornamenti del display finche' non si
# sblocca da sola: lo schermo continua a ruotare quello che ha, ma i messaggi
# nuovi non arrivano piu' e nessun timer riesce a rimediare.
NEXT_PUBLIC_FETCH_TIMEOUT_MS=8000
